// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  executor
}

enum CategoryKind {
  product
  service
}

enum Unit {
  pcs
  l
  kg
  m
}

enum PurchaseDestination {
  warehouse
  order
}

model Link {
  id        String   @id @default(uuid())
  label     String
  url       String
  productId String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  firstName        String
  lastName         String
  passwordHash     String
  role             Role     @default(executor)
  extraPermissions String[]
  blocked          Boolean  @default(false)
  roAppName        String?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  purchases Purchase[]
}

model Category {
  id   String       @id @default(uuid())
  name String
  kind CategoryKind @default(product)

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([parentId])
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  contact   String?
  phone     String[]
  email     String[]
  address   String?
  comment   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  purchases Purchase[]
}

model Product {
  id   String @id @default(uuid())
  name String

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  unit          Unit           @default(pcs)
  links         Link[]
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  purchaseItems PurchaseItem[]

  batches Batch[]

  @@index([categoryId])
}

model Purchase {
  id           String              @id @default(uuid())
  number       String              @unique // example: "P-00001"
  date         DateTime            @db.Timestamptz(3)
  docNumber    String?
  comment      String?
  destination  PurchaseDestination @default(warehouse)
  cancelled    Boolean             @default(false)
  cancelReason String?

  hasReceipt Boolean @default(false)

  orderId String?

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  createdById String
  user        User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  purchaseItems PurchaseItem[]

  batches Batch[]

  @@index([supplierId])
  @@index([createdById])
  @@index([date])
}

model PurchaseItem {
  id String @id @default(uuid())

  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  qty          Decimal @db.Decimal(12, 2)
  unitPriceKop Int
  note         String?

  batches Batch[]

  @@index([purchaseId])
  @@index([productId])
}

model Batch {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  purchaseId String?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])

  purchaseItemId String?
  purchaseItem   PurchaseItem? @relation(fields: [purchaseItemId], references: [id])

  qtyReceived  Decimal @db.Decimal(12, 2)
  qtyRemaining Decimal @db.Decimal(12, 2)

  unitPriceKop Int
  receivedAt   DateTime @default(now()) @db.Timestamptz(3)
  adjustment   Boolean  @default(false)

  @@index([productId, receivedAt, id])
  @@index([purchaseId])
  @@index([purchaseItemId])
}

model Counter {
  key   String @id
  value Int
}

model Client
